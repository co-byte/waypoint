{
  "datasets": [
    {
      "name": "ds_daily_budget",
      "displayName": "DBUs per day vs budget",
      "queryLines": [
        "WITH latest_billed AS (\n",
        "  SELECT date_sub(to_date(min(last_end)), 1) AS day\n",
        "  FROM (\n",
        "    SELECT max(usage_end_time) AS last_end\n",
        "    FROM system.billing.usage\n",
        "    WHERE usage_unit = 'DBU' AND billing_origin_product IN ('JOBS', 'DLT')\n",
        "      AND usage_date >= date_sub(current_date(), 7)\n",
        "    GROUP BY billing_origin_product\n",
        "  )\n",
        "),\n",
        "billed AS (\n",
        "  SELECT u.usage_date AS day, u.billing_origin_product AS product, sum(u.usage_quantity) AS dbus\n",
        "  FROM system.billing.usage u, latest_billed l\n",
        "  WHERE u.usage_unit = 'DBU'\n",
        "    AND u.usage_date BETWEEN least(:date_range.min, date_sub(l.day, 6)) AND l.day\n",
        "  GROUP BY ALL\n",
        "),\n",
        "last_billed_week AS (\n",
        "  SELECT b.*\n",
        "  FROM billed b, latest_billed l\n",
        "  WHERE b.day > date_sub(l.day, 7)\n",
        "),\n",
        "runtime_hours AS (\n",
        "  SELECT to_date(period_start_time) AS day, 'DLT' AS product,\n",
        "    sum(unix_timestamp(period_end_time) - unix_timestamp(period_start_time)) / 3600.0 AS hours\n",
        "  FROM system.lakeflow.pipeline_update_timeline\n",
        "  WHERE to_date(period_start_time) >= date_sub(current_date(), 10)\n",
        "  GROUP BY ALL\n",
        "  UNION ALL\n",
        "  SELECT to_date(period_start_time), 'JOBS', sum(execution_duration_seconds) / 3600.0\n",
        "  FROM system.lakeflow.job_task_run_timeline\n",
        "  WHERE to_date(period_start_time) >= date_sub(current_date(), 10)\n",
        "    AND result_state IS NOT NULL AND size(compute) > 0\n",
        "  GROUP BY ALL\n",
        "),\n",
        "dbus_per_runtime_hour AS (\n",
        "  SELECT w.product, try_divide(sum(w.dbus), sum(h.hours)) AS ratio\n",
        "  FROM last_billed_week w\n",
        "  JOIN runtime_hours h USING (day, product)\n",
        "  GROUP BY w.product\n",
        "),\n",
        "other_products_per_day AS (\n",
        "  SELECT coalesce(sum(dbus), 0) / 7 AS dbus\n",
        "  FROM last_billed_week\n",
        "  WHERE product NOT IN ('JOBS', 'DLT')\n",
        "),\n",
        "unbilled_days AS (\n",
        "  SELECT explode(sequence(date_add(day, 1), current_date())) AS day\n",
        "  FROM latest_billed\n",
        "),\n",
        "estimated AS (\n",
        "  SELECT\n",
        "    d.day,\n",
        "    coalesce(sum(h.hours * r.ratio), 0)\n",
        "      * CASE WHEN d.day = current_date()\n",
        "          THEN 24 / ((unix_timestamp(current_timestamp()) - unix_timestamp(current_date())) / 3600.0)\n",
        "          ELSE 1 END\n",
        "      + first(o.dbus) AS dbus\n",
        "  FROM unbilled_days d\n",
        "  CROSS JOIN other_products_per_day o\n",
        "  LEFT JOIN runtime_hours h ON h.day = d.day\n",
        "  LEFT JOIN dbus_per_runtime_hour r ON r.product = h.product\n",
        "  GROUP BY d.day\n",
        "),\n",
        "days AS (\n",
        "  SELECT day, sum(dbus) AS billed_dbus, CAST(NULL AS DOUBLE) AS estimated_dbus\n",
        "  FROM billed\n",
        "  GROUP BY day\n",
        "  UNION ALL\n",
        "  SELECT day, NULL, dbus\n",
        "  FROM estimated\n",
        ")\n",
        "SELECT\n",
        "  d.day,\n",
        "  d.billed_dbus,\n",
        "  d.estimated_dbus,\n",
        "  coalesce(d.billed_dbus, d.estimated_dbus) / :daily_dbu_budget AS budget_share,\n",
        "  :daily_dbu_budget AS budget,\n",
        "  d.day = l.day AS is_latest_billed_day,\n",
        "  d.day = current_date() AS is_today\n",
        "FROM days d, latest_billed l\n",
        "WHERE d.day BETWEEN :date_range.min AND :date_range.max\n"
      ],
      "parameters": [
        {
          "displayName": "date_range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-30d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        },
        {
          "displayName": "daily_dbu_budget",
          "keyword": "daily_dbu_budget",
          "dataType": "DECIMAL",
          "defaultSelection": {
            "values": {
              "dataType": "DECIMAL",
              "values": [
                {
                  "value": "100"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_task_concurrency",
      "displayName": "Job task concurrency",
      "queryLines": [
        "WITH task_runs AS (\n",
        "  SELECT\n",
        "    run_id,\n",
        "    max(period_end_time) AS ended,\n",
        "    max(execution_duration_seconds) AS execution_seconds\n",
        "  FROM system.lakeflow.job_task_run_timeline\n",
        "  WHERE to_date(period_start_time) BETWEEN date_sub(:date_range.min, 1) AND :date_range.max\n",
        "  GROUP BY run_id\n",
        "  HAVING max(result_state) IS NOT NULL AND max(execution_duration_seconds) > 0\n",
        "),\n",
        "events AS (\n",
        "  SELECT timestampadd(SECOND, -execution_seconds, ended) AS at, 1 AS delta FROM task_runs\n",
        "  UNION ALL\n",
        "  SELECT ended, -1 FROM task_runs\n",
        "),\n",
        "running AS (\n",
        "  SELECT at, sum(delta) OVER (ORDER BY at, delta ROWS UNBOUNDED PRECEDING) AS tasks\n",
        "  FROM events\n",
        ")\n",
        "SELECT\n",
        "  to_date(at) AS day,\n",
        "  max(tasks) AS peak_running,\n",
        "  5 AS task_limit\n",
        "FROM running\n",
        "WHERE to_date(at) BETWEEN :date_range.min AND :date_range.max\n",
        "GROUP BY to_date(at)\n"
      ],
      "parameters": [
        {
          "displayName": "date_range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-30d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "ds_warehouse_queue",
      "displayName": "SQL warehouse queue",
      "queryLines": [
        "SELECT\n",
        "  to_date(start_time) AS day,\n",
        "  count(*) AS queries,\n",
        "  percentile(waiting_at_capacity_duration_ms, 0.95) / 1000 AS p95_queue_seconds,\n",
        "  max(waiting_at_capacity_duration_ms) / 1000 AS max_queue_seconds\n",
        "FROM system.query.history\n",
        "WHERE to_date(start_time) BETWEEN :date_range.min AND :date_range.max\n",
        "GROUP BY to_date(start_time)\n"
      ],
      "parameters": [
        {
          "displayName": "date_range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-30d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "ds_pipelines",
      "displayName": "Pipelines per type",
      "queryLines": [
        "WITH latest AS (\n",
        "  SELECT pipeline_type, delete_time\n",
        "  FROM system.lakeflow.pipelines\n",
        "  QUALIFY row_number() OVER (PARTITION BY workspace_id, pipeline_id ORDER BY change_time DESC) = 1\n",
        ")\n",
        "SELECT\n",
        "  pipeline_type,\n",
        "  count(*) AS pipelines,\n",
        "  1 AS pipeline_limit\n",
        "FROM latest\n",
        "WHERE delete_time IS NULL\n",
        "GROUP BY pipeline_type\n"
      ]
    },
    {
      "name": "ds_usage",
      "displayName": "DBU usage",
      "queryLines": [
        "WITH pipeline_names AS (\n",
        "  SELECT workspace_id, pipeline_id, name\n",
        "  FROM system.lakeflow.pipelines\n",
        "  QUALIFY row_number() OVER (PARTITION BY workspace_id, pipeline_id ORDER BY change_time DESC) = 1\n",
        ")\n",
        "SELECT\n",
        "  u.usage_date,\n",
        "  u.billing_origin_product AS product,\n",
        "  coalesce(u.usage_metadata.job_name, p.name, u.billing_origin_product) AS workload,\n",
        "  u.usage_quantity AS dbus\n",
        "FROM system.billing.usage u\n",
        "LEFT JOIN pipeline_names p\n",
        "  ON u.workspace_id = p.workspace_id AND u.usage_metadata.dlt_pipeline_id = p.pipeline_id\n",
        "WHERE u.usage_unit = 'DBU'\n",
        "  AND u.usage_date BETWEEN :date_range.min AND :date_range.max\n"
      ],
      "parameters": [
        {
          "displayName": "date_range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-30d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "ds_runs",
      "displayName": "Job runs",
      "queryLines": [
        "WITH job_names AS (\n",
        "  SELECT workspace_id, job_id, name\n",
        "  FROM system.lakeflow.jobs\n",
        "  QUALIFY row_number() OVER (PARTITION BY workspace_id, job_id ORDER BY change_time DESC) = 1\n",
        "),\n",
        "runs AS (\n",
        "  SELECT\n",
        "    workspace_id,\n",
        "    job_id,\n",
        "    run_id,\n",
        "    min(period_start_time) AS run_start,\n",
        "    max(period_end_time) AS run_end,\n",
        "    max_by(result_state, period_end_time) AS result_state\n",
        "  FROM system.lakeflow.job_run_timeline\n",
        "  GROUP BY ALL\n",
        ")\n",
        "SELECT\n",
        "  to_date(r.run_start) AS run_date,\n",
        "  coalesce(j.name, r.job_id) AS job,\n",
        "  coalesce(r.result_state, 'RUNNING') AS result_state,\n",
        "  (unix_timestamp(r.run_end) - unix_timestamp(r.run_start)) / 60.0 AS duration_min,\n",
        "  CASE WHEN r.result_state IN ('ERROR', 'FAILED', 'TIMED_OUT') THEN 1 ELSE 0 END AS failed\n",
        "FROM runs r\n",
        "LEFT JOIN job_names j USING (workspace_id, job_id)\n",
        "WHERE to_date(r.run_start) BETWEEN :date_range.min AND :date_range.max\n"
      ],
      "parameters": [
        {
          "displayName": "date_range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-30d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    }
  ],
